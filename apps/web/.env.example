# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://studylab:studylab_dev_2024@localhost:5432/studylab

# ── Auth.js ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# ── AI Tutor (optional) ────────────────────────────────────
# NOTE: Uses TUTOR_ANTHROPIC_KEY (not ANTHROPIC_API_KEY) to avoid
# conflicts with Claude Code's environment variables.
# TUTOR_ANTHROPIC_KEY=your-anthropic-api-key-here

# ── Lab Engine (optional, needs the Docker stack) ──────────
# Must be the FULL endpoint URL, not just the host - the lab runner POSTs to
# this value directly, so a bare http://localhost:8100 returns 404.
# Leave unset to run Python labs via a local python3 subprocess; Bash, Docker
# and Ansible labs require this to be set.
# LAB_ENGINE_URL=http://localhost:8100/api/v1/sandbox/run
