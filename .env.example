# Optional AI tutor only. Core study needs neither value.
# Copy this file to .env beside the release package.json and edit locally.
# Never commit or share .env. The launcher keeps the API key server-side.
TUTOR_ANTHROPIC_KEY=
# Use a model ID currently supported by your Anthropic account.
# https://platform.claude.com/docs/en/models/overview
TUTOR_MODEL=
